    {
      "type": "timeseries",
      "title": "Sensor dropouts (P90 of the missing share per ride)",
      "id": 9,
      "description": "Training data: at most 1.6 % per ride (alert SensorDropoutsHigh above 5 %).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 7,
        "x": 17,
