        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      }
    },
    {
      "type": "timeseries",
      "title": "Accuracy on rides with a true label (1 h)",
      "id": 14,
      "description": "Test accuracy 69 %. Alert FeedbackAccuracyLow below 50 % (with more than 10 labels).",
