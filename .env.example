# cp .env.example .env
S3_ACCESS_KEY=mlops
S3_SECRET_KEY=mlops-secret
SEAWEEDFS_VERSION=latest
# Host port of MLflow. On macOS, AirPlay Receiver already uses 5000: set 5001 (and MLFLOW_TRACKING_URI accordingly)
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_DISABLE_AGENT_HINT=1
# Docker Hub account the images are pushed to (make image / image-webapp / push)
DOCKERHUB_USER=nicogil7
